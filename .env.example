# Copy to .env for local runs:  set -a; source .env; set +a; python -m digest --dry-run --print

# Slack - option A (simplest): Incoming Webhook for one channel
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Slack - option B: bot token (continuation messages go into a thread)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL=C0123456789

# Claude API (summaries + notable-paper picks). Without it, feed snippets are used.
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: raises GitHub API rate limit from 60 to 5000 req/h for local runs
# GITHUB_TOKEN=ghp_...
